# 範例：admin.example.com:9090 → script/services/admin/
#
# Pattern A：多 VHost 一服務一檔（獨立 port，物理隔離）
#
# Admin 介面常見需求：較嚴格的 body 限制、更嚴格的 CSP、獨立 port 方便防火牆規則。
#
# ⚠️  安全警告：此 vhost 無內建認證，正式環境暴露前必須加上認證。
#     請啟用下方的 access_by_lua_block 認證 stub，或改為更完整的 JWT / HMAC 驗證。
#
# 啟用方式：
#   1. mv vhost/admin.vhost.sample vhost/admin.vhost
#   2. 在 docker-compose.yml 的 ports 區段加入：
#        - "9090:9090"
#   3. 建立服務目錄：
#        mkdir -p script/services/admin/v1
#   4. docker compose up -d
#
# 本機測試：
#   curl -H "Host: admin.example.com" http://localhost:9090/admin/v1/<endpoint>

server {
    listen       9090;
    server_name  admin.example.com;

    # 比 default 更嚴格的 body 限制（admin 不該收大檔案）
    client_max_body_size    1m;
    client_body_buffer_size 256k;

    # 自訂 headers（覆寫共用預設）
    add_header X-Content-Type-Options  nosniff                          always;
    add_header X-Frame-Options         DENY                             always;
    add_header Referrer-Policy         no-referrer                      always;
    add_header Content-Security-Policy "default-src 'none'"             always;
    more_clear_headers                 Server;

    # Lua 腳本根目錄（容器內固定路徑，對應 Dockerfile 的 /app）
    set $SCRIPT_DIR "/app/script/services/admin";

    # ⚠️  認證 stub：正式環境必須啟用，並替換為實際 token 或 JWT 驗證邏輯
    # access_by_lua_block {
    #     local auth = ngx.var.http_authorization
    #     if not auth or auth ~= "Bearer your-admin-token" then
    #         ngx.status = ngx.HTTP_UNAUTHORIZED
    #         return ngx.exit(ngx.HTTP_UNAUTHORIZED)
    #     end
    # }

    include 'snippets/server-health.inc';

    location ~ ^/admin/v1/([_\-a-zA-Z0-9/]+)$ {
        default_type 'application/json;charset=utf-8';

        set $method $request_method;
        if ($http_x_http_method) {
            set $method  $http_x_http_method;
        }
        if ($http_x_http_method_override) {
            set $method  $http_x_http_method_override;
        }

        include 'snippets/access-method-allowlist.inc';

        content_by_lua_file "$SCRIPT_DIR/v1/$1/${method}.lua";
    }
}
