server {
    # 預設監聽埠口
    listen       8080;
    server_name  localhost;

    # 安全與資源限制
    client_max_body_size  4m;
    client_body_buffer_size 1m;

    # 基本安全 Headers
    add_header X-Content-Type-Options  nosniff                          always;
    add_header X-Frame-Options         DENY                             always;
    add_header Referrer-Policy         strict-origin-when-cross-origin  always;
    add_header Content-Security-Policy "default-src 'none'"             always;
    more_clear_headers                 Server;

    root "";
    set  $SCRIPT_DIR "${realpath_root}/script";

    location / {
        return 404;
    }

    # LB / Docker Health Check
    location = /healthcheck {
        access_log off;
        default_type 'text/plain';
        return 200 'ok';
    }

    location = /ping {
        access_log off;
        default_type 'text/plain';
        return 200 'pong';
    }

    # 範例：自動映射 /api/v1/... 到 Lua 腳本
    location ~ ^/api/v1/([_\-a-zA-Z0-9/]+)$ {
        default_type 'application/json;charset=utf-8';

        set $method $request_method;
        if ($http_x_http_method) {
            set $method  $http_x_http_method;
        }
        if ($http_x_http_method_override) {
            set $method  $http_x_http_method_override;
        }

        # Method allowlist：防止路徑穿越攻擊，限制合法 HTTP method
        access_by_lua_block {
            local allowed = {GET=1,POST=1,PUT=1,PATCH=1,DELETE=1,HEAD=1,OPTIONS=1}
            if not allowed[ngx.var.method] then
                ngx.status = 405
                ngx.header.content_type = 'application/json; charset=utf-8'
                ngx.print('{"message":"UNSUPPORTED","description":"Method not allowed"}')
                return ngx.exit(ngx.OK)
            end
            -- 鏈路追蹤 (如有需要可解除以下兩行的註解)
            -- require("server_tracing").start()
        }

        content_by_lua_file "$SCRIPT_DIR/api/v1/$1/${method}.lua";

        # 鏈路追蹤 Flush (如有需要可解除以下兩行的註解)
        # body_filter_by_lua_block {
        #     require("server_tracing").flush()
        # }
    }
}
