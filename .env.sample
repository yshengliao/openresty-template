# 建置版本資訊（CI 注入或手動填寫；Dockerfile 無 ARG 接收，由 K8s env / docker compose 注入）
BUILD_COMMIT_TAG=v0.0.0-local
BUILD_COMMIT_SHA=0000000000000000000000000000000000000001

# 服務名稱（用於 OTel trace resource）
SERVICE_NAME=GatewayTemplate

# jaeger (optional)
# JaegerCollector_Host：填入 hostname 或 IP，不含 scheme（OTLP exporter 自動加上 http://）
# 帶 scheme 的值（如 http://127.0.0.1）同樣可用，但預設值與 config.lua 一致使用純 hostname
JaegerCollector_Host=127.0.0.1
JaegerCollector_OTLPHttpPort=4318


# local only
